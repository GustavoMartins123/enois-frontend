# Convenções que o editor aplica sozinho — vale para quem usa VS Code, JetBrains ou vim.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,json,css,md,yml,yaml}]
indent_size = 2

[*.md]
# Markdown usa duas espaços no fim da linha para quebrar linha — não tirar.
trim_trailing_whitespace = false
