# Variaveis do front (VITE_* sao embutidas no bundle e ficam publicas).
VITE_API_BACKEND=https://enois.ia.br/api
VITE_IMAGEKIT_PUBLIC_KEY=public_xxxx
VITE_IMAGEKIT_UPLOAD_URL=https://upload.imagekit.io/api/v1/files/upload
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/socialcoisa

# Cloudflare Turnstile (anti-bot). Sem essa variavel, o widget nao aparece.
# Dev/teste: use a test key 1x00000000000000000000AA (sempre passa).
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# SEGREDO - NAO commitar. Deve chegar em runtime como variavel de ambiente do container
# (server function getImageKitAuth le process.env.IMAGEKIT_PRIVATE_KEY).
# IMAGEKIT_PRIVATE_KEY=private_xxxx
